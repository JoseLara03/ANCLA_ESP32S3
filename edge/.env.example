# ---- local broker (anchors publish blinks here; the gateway publishes the anchor map) ----
LOCAL_HOST=host.docker.internal
LOCAL_PORT=1883
LOCAL_USER=
LOCAL_PASS=
LOCAL_TLS=0

# ---- cloud broker the platform already reads ("MQTT original") ----
PUBLISH_CLOUD=0
CLOUD_HOST=duck.lmq.cloudamqp.com
CLOUD_PORT=8883
CLOUD_USER=
CLOUD_PASS=
CLOUD_TLS=1
CLOUD_TLS_INSECURE=0
# Also forward the retained anchor map (uwb/anchor/setup/<zone>) to the cloud broker.
FORWARD_SETUP=1

# ---- site ----
ZONE=852541
# The tag plane's z in the survey frame (`apos tagz` on the gateway). Only its
# square enters the model, so the sign is irrelevant; the MAGNITUDE (anchor-to-tag
# vertical separation, metres) matters a lot on a 2-3 m array.
TAG_Z=-0.9
# Short address -> platform Tid. The firmware derives Tid from the tag's EUI via the
# gateway's seat table; the edge only sees short addresses. Unmapped tags publish
# their short address, as the gateway does for a tag with no live seat.
TID_MAP=256:693116308

# Anchors cannot be reached once mounted, so two protections live here instead of in them:
# - An anchor whose published sync sigma ("e", DTU) exceeds SIGMA_MAX_DTU is left out of the
#   solve while >= 3 others remain, and the reference is the anchor with the smallest sigma.
#   0 disables. Healthy anchors publish 15-50; a corrupt time conversion publishes ~30000.
SIGMA_MAX_DTU=1000
# - Static per-anchor timestamp error in DTU, SUBTRACTED before solving (positive = that
#   anchor's converted time is late). Replaces `sync tau set` on each anchor. Measure it with
#   tools/calibrate.py from one tag at a known position. {"1":-48,"3":62}
OFFSETS_DTU=

# Optional: fixed geometry instead of the retained anchor map. {"0":[x,y,z],...}
ANCHORS_JSON=

STATS_PERIOD_S=10
LOG_LEVEL=INFO
